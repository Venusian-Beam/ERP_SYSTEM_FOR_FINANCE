APP_NAME="Financial ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8020

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=spydar_erp_dev
DB_USERNAME=postgres
DB_PASSWORD=secret_pass

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

TENANT_HEADER=X-Tenant
TENANT_CENTRAL_DOMAINS=localhost,127.0.0.1
TENANT_STORAGE_DISK=local
TWILIO_AUTH_TOKEN=
